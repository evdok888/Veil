# Telegram Bot Configuration
# Copy this file to .env and fill in the values

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# SuperGroup ID where topics will be created (must be negative number for supergroups)
# Get it by forwarding a message from the group to @userinfobot or using getUpdates API
SUPERGROUP_ID=-1001234567890

# Owner's Telegram User ID (who can send messages to clients)
# Get it by sending /start to your bot and checking logs or using @userinfobot
OWNER_USER_ID=123456789

# Webhook URL for production (HTTPS endpoint, e.g., https://yourdomain.com/webhook)
# Leave empty for polling mode (development)
WEBHOOK_URL=

# Server listen address for webhook mode
SERVER_ADDR=:8443

# SQLite database path
DB_PATH=./bot.db

# Rate limiting: max messages per minute per client (0 to disable)
RATE_LIMIT_PER_MINUTE=60

# Message shown to blocked users when they try to send a message
BLOCKED_MESSAGE=Диалог завершён. Вы не можете отправлять сообщения.

# Enable debug logging (true/false)
DEBUG_LOG=false
